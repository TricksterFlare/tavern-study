# Copy this file to .env.local and fill in your own deployed Worker.
# The frontend builds every API base URL as `${NEXT_PUBLIC_WORKER_URL}/${NEXT_PUBLIC_AUTH_TOKEN}`,
# matching the path-token gate on the writer's-desk admin surface in examples/cloudflare/index.ts.
NEXT_PUBLIC_WORKER_URL=https://your-worker.example.workers.dev
NEXT_PUBLIC_AUTH_TOKEN=replace-with-your-own-auth-token
